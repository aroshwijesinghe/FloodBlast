# ═══════════════════════════════════════════════════════════════
# FloodBlast — Production Environment Variables
# Copy this file to .env and fill in all values before deploying.
# !! Never commit .env to git !!
# ═══════════════════════════════════════════════════════════════

# ─── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=floodblast
POSTGRES_USER=floodblast_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ─── Redis ───────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379

# ─── MinIO / S3 ──────────────────────────────────────────────
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=floodblast_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET_NAME=floodblast-media

# ─── NestJS Server ───────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=CHANGE_ME_REFRESH_SECRET
REFRESH_TOKEN_EXPIRES_IN=7d
CORS_ORIGIN=https://your-domain.com,https://eoc.your-domain.com

# ─── Firebase Cloud Messaging (FCM) ──────────────────────────
FCM_PROJECT_ID=your-firebase-project-id
FCM_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# ─── SMS Gateway (Dialog Ideamart / SLT-Mobitel) ─────────────
SMS_GATEWAY_URL=https://api.dialog.lk/sms/send
SMS_API_KEY=CHANGE_ME_SMS_API_KEY
SMS_SENDER_ID=FloodBlast

# ─── AI Service ──────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:8001
WHISPER_MODEL=small
OPENAI_API_KEY=sk-...  # optional — only if using OpenAI API fallback

# ─── Google Maps ─────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_KEY
